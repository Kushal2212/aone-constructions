# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of exact frontend origins allowed by CORS.
# Local: http://localhost:5173   Production: https://your-frontend-domain.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of the API (1 for Render/Railway/Fly/Vercel).
TRUST_PROXY=1

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="replace-with-a-strong-password"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional response caching. Leave empty to run without Redis.
REDIS_URL=redis://localhost:6379
MEDIA_MAX_FILE_SIZE_MB=100
